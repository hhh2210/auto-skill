# Copy this file to `.env` and fill in the real key locally.

BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_API_KEY=replace-with-your-api-key
BAILIAN_MODEL=qwen3.5-plus

# Optional defaults used by scripts.
# Leave BAILIAN_TEMPERATURE unset to use the provider/model default.
# Set it explicitly for reproducible batch generation once we choose a policy.
# BAILIAN_TEMPERATURE=0.2
# Qwen3.5 hybrid-thinking models accept this OpenAI-compatible extra_body flag.
# Set false for faster deterministic data cleaning / smoke eval loops.
# BAILIAN_ENABLE_THINKING=false
# Optional: cap reasoning tokens when thinking is enabled for selected stages.
# BAILIAN_THINKING_BUDGET=4096
# Optional: stream responses internally for long-running calls.
# Set BAILIAN_STREAM_LOG=true only for sequential debugging; batch logs will interleave.
# BAILIAN_STREAM=true
# BAILIAN_STREAM_LOG=false
# BAILIAN_STREAM_INCLUDE_USAGE=true
BAILIAN_TIMEOUT_SECONDS=600
BAILIAN_MAX_RETRIES=0
BAILIAN_NUM_THREADS=16

# Optional: separate multimodal Qwen config for PresentBench material digests.
# When omitted, scripts can reuse BAILIAN_*; set this when using a dedicated
# vision-capable model such as qwen3-vl-plus.
# QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_VL_API_KEY=replace-with-your-api-key
# QWEN_VL_MODEL=qwen3-vl-plus
# QWEN_VL_ENABLE_THINKING=false

# Optional: split-judge config used by eval runners with --judge-config-prefix.
# Only JUDGE_MODEL is required; JUDGE_BASE_URL / JUDGE_API_KEY fall back to BAILIAN_*.
# Use this to break Qwen-judge monoculture in reported experiments.
# JUDGE_BASE_URL=https://api.anthropic.com/v1
# JUDGE_API_KEY=replace-with-judge-key
# JUDGE_MODEL=claude-sonnet-4-6

# Optional: official PresentBench judge config.
# Required only when running scripts/eval/run_presentbench_official_judge.py.
# Upstream PresentBench currently supports gemini / gemini_inline here, not
# OpenAI-compatible Qwen/Bailian.
# GENAI_API_KEY=replace-with-gemini-key
# Optional: custom Gemini-compatible endpoint.
# GENAI_BASE_URL=https://generativelanguage.googleapis.com

# Optional: OpenAI-compatible proxy for Gemini-class PresentBench judging.
# Use with scripts/eval/run_presentbench_official_judge.py --api-type openai.
# GOOGLE_THIRD_API_URL=https://replace-with-openai-compatible-endpoint/v1
# GOOGLE_THIRD_API_KEY=replace-with-proxy-key
# GOOGLE_THIRD_API_TIMEOUT_SECONDS=600
# GOOGLE_THIRD_API_MAX_RETRIES=0
